"""
K230 YOLO steel-ball position sender for the 2026 TI H problem.

UART wiring:
K230 GPIO11 TX -> MSPM0G3507 PA1 RX
K230 GPIO12 RX -> MSPM0G3507 PA0 TX
GND -> GND
"""

from libs.PipeLine import PipeLine
from libs.YOLO import YOLO11
from machine import FPIOA, UART
from media.sensor import *
import gc
import os
import time


MODEL_PATH = "/sdcard/yolo11n_det_320.kmodel"
FALLBACK_MODEL_PATH = "datav/data/yolo11n_det_320.kmodel"
LABELS = ["steel_ball"]
MODEL_INPUT_SIZE = [320, 320]

DISPLAY = "lcd3_5"
RGB888P_SIZE = [640, 360]

# Manual rod calibration. Tune these two values on the real camera image.
LEFT_PX = 95
RIGHT_PX = 545
ROD_LEFT_MM = -120
ROD_RIGHT_MM = 120
CENTER_PX = (LEFT_PX + RIGHT_PX) / 2.0
MM_PER_PIXEL = (ROD_RIGHT_MM - ROD_LEFT_MM) / float(RIGHT_PX - LEFT_PX)

CONF_THRESH = 0.55
NMS_THRESH = 0.45
MAX_BOXES_NUM = 10
MAX_JUMP_MM = 30
LOST_FRAME_LIMIT = 3
SEND_EVERY_N_FRAMES = 1
TERMINAL_PRINT_EVERY_N_FRAMES = 5
LOST_SEND_EVERY_N_FRAMES = 5
DEBUG_FRAME_STATUS = True


def file_exists(path):
    try:
        os.stat(path)
        return True
    except OSError:
        return False


def resolve_model_path():
    if file_exists(MODEL_PATH):
        return MODEL_PATH
    if file_exists(FALLBACK_MODEL_PATH):
        return FALLBACK_MODEL_PATH
    raise RuntimeError("kmodel not found on /sdcard or /data")


def get_display_config(display):
    if display == "hdmi":
        return "hdmi", [1920, 1080], Sensor(width=1920, height=1080)
    if display == "lcd2_4":
        return "st7701", [640, 480], Sensor(width=1280, height=960)
    if display == "lcd3_5":
        return "st7701", [800, 480], Sensor(width=1920, height=1080)
    raise ValueError("DISPLAY must be hdmi, lcd3_5, or lcd2_4")


def setup_uart2():
    fpioa = FPIOA()
    fpioa.set_function(11, FPIOA.UART2_TXD)
    fpioa.set_function(12, FPIOA.UART2_RXD)
    return UART(
        UART.UART2,
        baudrate=115200,
        bits=UART.EIGHTBITS,
        parity=UART.PARITY_NONE,
        stop=UART.STOPBITS_ONE,
    )


def uart_send(uart, text):
    uart.write(text)


def clamp_position_mm(x_mm):
    if x_mm < ROD_LEFT_MM:
        return ROD_LEFT_MM
    if x_mm > ROD_RIGHT_MM:
        return ROD_RIGHT_MM
    return x_mm


def pixel_to_mm(cx):
    x_mm = int((cx - CENTER_PX) * MM_PER_PIXEL)
    return clamp_position_mm(x_mm)


def detection_score(det):
    if isinstance(det, dict):
        if "score" in det:
            return float(det["score"])
        if "confidence" in det:
            return float(det["confidence"])
        if "conf" in det:
            return float(det["conf"])
        return 0.0

    if isinstance(det, (list, tuple)):
        best = 0.0
        for value in det:
            if isinstance(value, float) and value > best and value <= 1.0:
                best = value
        return best

    return 0.0


def detection_center_x(det):
    if isinstance(det, dict):
        if "bbox" in det:
            box = det["bbox"]
            return (float(box[0]) + float(box[2])) / 2.0
        if "box" in det:
            box = det["box"]
            return (float(box[0]) + float(box[2])) / 2.0
        if "x1" in det and "x2" in det:
            return (float(det["x1"]) + float(det["x2"])) / 2.0
        if "cx" in det:
            return float(det["cx"])

    if isinstance(det, (list, tuple)):
        if len(det) >= 6:
            return (float(det[2]) + float(det[4])) / 2.0
        if len(det) >= 4:
            return (float(det[0]) + float(det[2])) / 2.0

    return None


def choose_best_detection(result):
    best = None
    best_score = -1.0

    if result is None:
        return None, 0.0

    for det in result:
        score = detection_score(det)
        if score > best_score:
            best = det
            best_score = score

    return best, best_score


def send_ball(uart, seq, x_mm, conf, fps, log=False):
    uart_send(uart, "BALL,{},{},{:.2f},{}\n".format(seq, x_mm, conf, int(fps)))
    if log:
        print(
            "K230_BALL seq={} x_mm={} conf={:.2f} fps={} sent=1".format(
                seq, x_mm, conf, int(fps)
            )
        )


def send_lost(uart, seq, log=False):
    uart_send(uart, "BALL_LOST,{}\n".format(seq))
    if log:
        print("K230_BALL_LOST seq={} sent=1".format(seq))


def print_frame_status(frame_id, fps, seen, cx, x_mm, conf, lost_frames, sent):
    if not DEBUG_FRAME_STATUS:
        return
    if frame_id % TERMINAL_PRINT_EVERY_N_FRAMES != 0:
        return
    if seen:
        print(
            "K230_FRAME id={} fps={} seen=1 cx={} x_mm={} conf={:.2f} lost_frames={} sent={}".format(
                frame_id, int(fps), int(cx), x_mm, conf, lost_frames, sent
            )
        )
    else:
        print(
            "K230_FRAME id={} fps={} seen=0 lost_frames={} sent={}".format(
                frame_id, int(fps), lost_frames, sent
            )
        )


def main():
    uart = setup_uart2()
    pl = None
    yolo = None
    seq = 0
    lost_frames = 0
    last_x_mm = None

    try:
        display_mode, display_size, sensor = get_display_config(DISPLAY)
        pl = PipeLine(
            rgb888p_size=RGB888P_SIZE,
            display_size=display_size,
            display_mode=display_mode,
        )
        pl.create(sensor=sensor)

        yolo = YOLO11(
            task_type="detect",
            mode="video",
            kmodel_path=resolve_model_path(),
            labels=LABELS,
            rgb888p_size=RGB888P_SIZE,
            model_input_size=MODEL_INPUT_SIZE,
            display_size=pl.get_display_size(),
            conf_thresh=CONF_THRESH,
            nms_thresh=NMS_THRESH,
            max_boxes_num=MAX_BOXES_NUM,
            debug_mode=0,
        )
        yolo.config_preprocess()

        clock = time.clock()
        frame_id = 0

        while True:
            clock.tick()
            img = pl.get_frame()
            result = yolo.run(img)
            yolo.draw_result(result, pl.osd_img)
            pl.show_image()

            frame_id += 1
            sent = 0
            seen = False
            x_mm = None
            det, conf = choose_best_detection(result)
            cx = detection_center_x(det) if det is not None else None

            if conf >= CONF_THRESH and cx is not None:
                x_mm = pixel_to_mm(cx)
                if last_x_mm is not None and abs(x_mm - last_x_mm) > MAX_JUMP_MM:
                    lost_frames += 1
                else:
                    seen = True
                    last_x_mm = x_mm
                    lost_frames = 0
                    if frame_id % SEND_EVERY_N_FRAMES == 0:
                        seq = (seq + 1) & 0xFFFF
                        send_ball(uart, seq, x_mm, conf, clock.fps())
                        sent = 1
            else:
                lost_frames += 1

            if lost_frames >= LOST_FRAME_LIMIT and frame_id % LOST_SEND_EVERY_N_FRAMES == 0:
                seq = (seq + 1) & 0xFFFF
                send_lost(uart, seq)
                sent = 1
                last_x_mm = None

            print_frame_status(
                frame_id, clock.fps(), seen, cx, x_mm, conf, lost_frames, sent
            )

            gc.collect()

    finally:
        if yolo is not None:
            yolo.deinit()
        if pl is not None:
            pl.destroy()
        gc.collect()


main()
