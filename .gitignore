# ============================
# TI Code Composer Studio (CCS)
# ============================

# Build output directories (at any level)
Debug/
Release/

# CCS build artifacts
*.o
*.out
*.elf
*.hex
*.bin
*.map

# CCS generated build support files
ccsObjs.opt
device.opt
device.cmd.genlibs
device_linker.cmd

# Makefile artifacts (auto-generated by CCS)
makefile
objects.mk
sources.mk
subdir_rules.mk
subdir_vars.mk

# Compiler dependency files
*.d
*.d_raw

# Linker report / info
*_linkInfo.xml

# Clangd LSP cache directory + auto-generated root config
.clangd/
.clangd

# SysConfig generated files (in any Debug/ directory)
ti_msp_dl_config.c
ti_msp_dl_config.h

# ============================
# System files (Windows)
# ============================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ============================
# System files (macOS)
# ============================
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# ============================
# System files (Linux)
# ============================
*~

# ============================
# Editor temporary files
# ============================
*.swp
*.swo
*.swn
*.bak
*.tmp

# ============================
# IDE / Editor local settings
# ============================
.theia/
.vscode/
.idea/
*.user
*.depend
*.lock

# ============================
# Accidental / stray artifacts
# ============================
nul

# ============================
# Claude Code session data
# ============================
.claude/